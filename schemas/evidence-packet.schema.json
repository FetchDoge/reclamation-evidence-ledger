{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Self-describing evidence packet for one site assessment. The schema is the contract: every packet honors it, every renderer trusts it.",
  "properties": {
    "assessment_date": {
      "format": "date",
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "description": "Baseline-season summary (optional).",
      "properties": {
        "period": {
          "type": "string"
        },
        "ndvi_median": {
          "type": "number",
          "description": "Median of per-month baseline medians over matched months. Context only: the delta is NOT derived by subtracting this from assessment_detail.ndvi_median."
        },
        "n_scene_observations": {
          "type": "integer",
          "description": "Count of scene-level clear-pixel NDVI means (one per scene per month) in baseline years falling in matched months. Distinct from assessment_detail.n_scene_observations (current period) and from len(observations) (all scenes, all months)."
        }
      }
    },
    "chips": {
      "description": "Raw image chips, untouched, with checksums.",
      "items": {
        "properties": {
          "bands": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "claim": {
      "properties": {
        "caveats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "not_assessable",
            "detected",
            "identified"
          ],
          "type": "string",
          "description": "Pipeline output is never 'attributed'. 'not_assessable' is a first-class result: the screen declines to make a claim (see not_assessable_reasons). Attribution requires human review."
        },
        "not_assessable_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Why no claim is made, e.g. location_unverified, insufficient_matched_months, chips_not_at_verified_location."
        }
      },
      "required": [
        "tier",
        "statement",
        "rationale"
      ],
      "type": "object"
    },
    "observations": {
      "items": {
        "properties": {
          "bare_soil_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "clear_pixel_fraction": {
            "type": "number"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "ndmi_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "ndvi_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "scene_id": {
            "type": "string"
          },
          "savi_mean": {
            "type": [
              "number",
              "null"
            ],
            "description": "Soil-Adjusted Vegetation Index scene mean (supporting evidence; NDVI is primary)."
          },
          "msavi_mean": {
            "type": [
              "number",
              "null"
            ],
            "description": "Modified SAVI scene mean (supporting evidence; NDVI is primary)."
          }
        },
        "required": [
          "date",
          "scene_id",
          "ndvi_mean",
          "ndmi_mean",
          "clear_pixel_fraction"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "packet_id": {
      "description": "site_id + assessment date, stable",
      "type": "string"
    },
    "provenance": {
      "properties": {
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "sources": {
          "items": {
            "properties": {
              "accessed": {
                "format": "date",
                "type": "string"
              },
              "license_note": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url",
              "accessed"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "generated_at",
        "generated_by"
      ],
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "1.1.0",
        "1.2.0"
      ],
      "type": "string",
      "description": "1.1.0 = legacy (pre-geolocation-gate) packets, kept for the published record. 1.2.0 = location-gated packets with the not_assessable tier."
    },
    "site": {
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "owa_inventory_date": {
          "format": "date",
          "type": "string"
        },
        "owa_stage": {
          "enum": [
            "decommissioning",
            "reclamation",
            "closed",
            "unassigned",
            "unknown"
          ],
          "type": "string"
        },
        "site_id": {
          "type": "string"
        },
        "uwi": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "required": [
            "status",
            "source",
            "method"
          ],
          "description": "Provenance of the site coordinates (ledger.geolocate). Only status 'verified' may carry a claim tier above not_assessable.",
          "properties": {
            "status": {
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "source": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "uncertainty_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "site_id",
        "latitude",
        "longitude",
        "owa_stage"
      ],
      "type": "object"
    },
    "transforms": {
      "description": "Every operation applied, in order. The argument against the result.",
      "items": {
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "step": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "tool",
          "parameters"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "assessment_detail": {
      "type": "object",
      "description": "Assessment detail (optional).",
      "properties": {
        "period": {
          "type": "string"
        },
        "ndvi_median": {
          "type": "number",
          "description": "Median of per-month current-period medians over matched months. Context only: the delta is NOT derived by subtracting baseline.ndvi_median from this."
        },
        "n_scene_observations": {
          "type": "integer",
          "description": "Count of scene-level clear-pixel NDVI means (one per scene per month) in assessment years falling in matched months. Distinct from baseline.n_scene_observations (baseline period) and from len(observations) (all scenes, all months)."
        },
        "delta_vs_baseline": {
          "type": "number",
          "description": "Median of the per-month (current-median minus baseline-median) deltas over matched months. This is NOT the difference of the two ndvi_median fields (median of differences != difference of medians); see delta_method_note."
        },
        "delta_std": {
          "type": "number",
          "description": "Standard deviation of the matched-month deltas — the spread of the month-for-month differences the delta summarizes. NOT baseline NDVI variation; named for what it is."
        },
        "delta_method_note": {
          "type": "string",
          "description": "Plain-language statement of how delta_vs_baseline relates (and does not relate) to the displayed medians."
        },
        "delta_ci95": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Bootstrap 95% CI [lo, hi] on the median matched-month delta. OMITTED (not null) when fewer than 4 months are matched: at n<4 the resampled-median distribution is degenerate, so absence of the field is the honest uncertainty statement."
        },
        "matched_months": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Calendar months compared month-for-month (phenology guard)."
        }
      }
    }
  },
  "required": [
    "packet_id",
    "schema_version",
    "site",
    "assessment_date",
    "claim",
    "observations",
    "transforms",
    "provenance"
  ],
  "title": "Reclamation Evidence Packet",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "site": {
            "required": [
              "location"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "site": {
            "properties": {
              "location": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "location"
            ]
          }
        },
        "required": [
          "site"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "properties": {
              "tier": {
                "const": "not_assessable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim": {
            "properties": {
              "tier": {
                "const": "not_assessable"
              }
            },
            "required": [
              "tier"
            ]
          }
        },
        "required": [
          "claim"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "required": [
              "not_assessable_reasons"
            ]
          }
        }
      }
    }
  ]
}
